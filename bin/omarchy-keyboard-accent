#!/usr/bin/env python3
"""Follow the active Omarchy theme accent on an AULA F75 Max keyboard. See accent/controller.py."""
import sys
from pathlib import Path

# the packages sit next to bin/ in the repository, or where install.sh puts them
for lib in (Path(__file__).resolve().parent.parent,
            Path.home() / ".local/share/omarchy-keyboard-accent"):
    if (lib / "aula_f75").is_dir():
        sys.path.insert(0, str(lib))
        break

from accent.controller import main  # noqa: E402

sys.exit(main())

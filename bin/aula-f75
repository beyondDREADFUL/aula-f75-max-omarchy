#!/bin/bash
# Helper for the AULA F75 Max bar widget. Wraps `f75ctl theme` and `f75ctl`.
# Every command prints one line of JSON, so the widget needs no exit codes.
#
#   status                              theme, keyboard colour, match, pin, effect, speed,
#                                       brightness, connected transports, music and its
#                                       background
#   palette                             the theme's colours and what the keys would show
#   preview [--exact] #HEX              same for a single colour
#   apply   [--exact] [--pin] #HEX      set the keyboard
#   reset                               clear any pin, return to the theme colour
#   rainbow [on|off] [SPEED]            the firmware's rainbow flag on the current effect;
#                                       a colour or reset turns it off
#   effect  NAME|default [SPEED]        show the accent as this effect (default: config's)
#   choices                             the effect, bar and background names (one source)
#   brightness N                        brightness 1-5
#   transition none|fade|wave|explode   how the keys change colour over the cable
#   battery                             battery percent (2.4 GHz dongle only)
#   music   start [--bars NAME] [--background NAME]
#                                       start the music visualiser (USB cable only); changing
#                                       either while it runs restarts it. NAME for bars: any
#                                       f75ctl music --color name but off; for the background:
#                                       off, theme, spectrum-cycle or a solid colour.
#                                       `music start off|theme` still sets the background.
#   music   stop                        stop it; the keyboard returns to the theme colour
#
# Exit codes of the controller with --strict, as used here: 0 applied, 3 nothing applied
# because the keyboard is missing or busy (reported as {ok:false, error:...}), else failed.
#
# --exact uses the colour as written. Without it the controller applies the
# theme's saturation and lightness limits, which tint neutrals such as white.
# --pin keeps the colour across theme changes and reconnects; without it the
# colour lasts until the next theme change and any earlier pin is cleared.

set -u

F75CTL="$HOME/.local/bin/f75ctl"
controller() { "$F75CTL" theme "$@"; }
STATE_DIR="$HOME/.local/state/omarchy/aula-f75"
STATE="$STATE_DIR/state.json"
PIN="$STATE_DIR/pin.json"
MUSIC_PID="$STATE_DIR/music.pid"
MUSIC_LOG="$STATE_DIR/music.log"
MUSIC_BG="$STATE_DIR/music.background"
MUSIC_BARS="$STATE_DIR/music.bars"
THEME_LOG="$STATE_DIR/theme.log"
CHOICES=""

# The controller's lists of effects, bars and backgrounds, read once per run.
load_choices() {
    [ -n "$CHOICES" ] && return 0
    CHOICES=$(controller choices --json 2>/dev/null) && jq -e '.bars and .backgrounds' <<<"$CHOICES" >/dev/null 2>&1 \
        || { CHOICES=""; fail "could not read the choices"; }
}

# in_choices LIST NAME: is NAME in the controller's list (effects, bars, backgrounds)?
in_choices() { jq -e --arg v "$2" ".$1 | index(\$v) != null" <<<"$CHOICES" >/dev/null 2>&1; }

# Field 22 of /proc/PID/stat, the process start time. The comm field may hold spaces and
# parentheses, so cut after the last ')': field 22 is then the 20th word.
proc_start() {
    local stat fields
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    read -ra fields <<<"${stat##*)}"
    [ -n "${fields[19]:-}" ] && echo "${fields[19]}"
}

# The pid of the running visualiser, if any. music.pid holds `PID STARTTIME`; both must match
# the live process (a reused pid fails the start time) and its command line must be f75ctl
# music. A bare `PID` (older file) is accepted by the command line check alone.
music_pid() {
    local pid="" start="" cmdline now
    { read -r pid start _ <"$MUSIC_PID"; } 2>/dev/null || true
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)
    [[ $cmdline == *f75ctl* && $cmdline == *music* ]] || return 1
    if [ -n "$start" ]; then
        now=$(proc_start "$pid") && [ "$now" = "$start" ] || return 1
    fi
    echo "$pid"
}

# Run a controller command with --strict. Exit 3 means nothing was applied because the
# keyboard is missing or busy; the last line of theme.log says which.
run_strict() {
    local message=$1 code reason last
    shift
    controller "$@" --strict >/dev/null 2>&1
    code=$?
    [ "$code" -eq 0 ] && return 0
    if [ "$code" -eq 3 ]; then
        reason="keyboard not connected or busy"
        last=$(tail -n 1 "$THEME_LOG" 2>/dev/null)
        case $last in
        *result=deferred*) reason="keyboard busy" ;;
        *result=skipped*) reason="keyboard not connected" ;;
        esac
        fail "$reason"
    fi
    fail "$message"
}

fail() {
    jq -nc --arg error "$1" '{ok: false, error: $error}'
    exit 1
}

valid_hex() { [[ ${1:-} =~ ^#[0-9A-Fa-f]{6}$ ]]; }

# Sum of per-channel differences between two #RRGGBB colours.
hex_distance() {
    local a=${1#\#} b=${2#\#} total=0 i diff
    for i in 0 2 4; do
        diff=$((16#${a:i:2} - 16#${b:i:2}))
        total=$((total + (diff < 0 ? -diff : diff)))
    done
    echo "$total"
}

# What the keys would show for a colour, via the controller's dry run.
dry_target() {
    controller apply --dry-run ${exact[@]+"${exact[@]}"} --color "$1" 2>/dev/null \
        | grep -oE 'target=#[0-9A-Fa-f]{6}' | head -n 1 | cut -d= -f2
}

command=${1:-}
[ $# -gt 0 ] && shift

exact=()
pin=false
while [ $# -gt 0 ]; do
    case "$1" in
    --exact) exact=(--exact) ;;
    --pin) pin=true ;;
    *) break ;;
    esac
    shift
done

if [ ! -x "$F75CTL" ]; then
    fail "f75ctl is not installed: run install.sh (see README)"
fi

case "$command" in
status)
    status=$(controller status --json 2>/dev/null)
    # \x1f, not a tab: read collapses runs of whitespace separators, so an empty field
    # (no keyboard colour yet) would shift the rest along
    theme="" keyboard="" brightness=0 transport="" effect="" speed="" transition="" pinned="" rainbow=""
    IFS=$'\x1f' read -r theme keyboard brightness transport effect speed transition pinned rainbow < <(
        jq -r '[.target // "", .state.target // "", (.state.brightness // 0), .state.transport // "",
                .effect // "", (.speed // ""), .transition // "", .pin.color // "", (.rainbow // false)]
               | map(tostring) | join("\u001f")' <<<"$status" 2>/dev/null
    )
    [ -n "$theme" ] || fail "could not read the theme colour"
    devices=$(jq -c 'if (.devices | type) == "array" then .devices else [] end' <<<"$status" 2>/dev/null)
    [ -n "$devices" ] || devices='[]'
    # --argjson values must be valid JSON: integers and booleans, else a default
    [[ $brightness =~ ^[0-9]+$ ]] || brightness=0
    [[ $speed =~ ^[0-9]+$ ]] || speed=3
    [[ $rainbow == true ]] || rainbow=false
    music=false
    music_pid >/dev/null && music=true
    music_bg=$(cat "$MUSIC_BG" 2>/dev/null)
    music_bars=$(cat "$MUSIC_BARS" 2>/dev/null)
    # the source of the colour last applied, which status (the theme's own) doesn't report
    source=$(jq -r '.accent_source // ""' "$STATE" 2>/dev/null)
    # Rounding in the controller can leave a colour a step or two off, which
    # the eye cannot tell apart, so treat a small distance as a match.
    matches=false
    if valid_hex "$keyboard" && [ "$(hex_distance "$theme" "$keyboard")" -le 3 ]; then
        matches=true
    fi
    jq -nc --arg theme "$theme" --arg keyboard "$keyboard" --arg source "$source" --arg pinned "$pinned" \
        --argjson matches "$matches" --argjson brightness "$brightness" --arg transport "$transport" \
        --arg effect "${effect:-static}" --argjson music "$music" --argjson speed "$speed" \
        --argjson devices "$devices" --arg music_bg "${music_bg:-off}" --arg music_bars "${music_bars:-rainbow}" \
        --arg transition "${transition:-wave}" --argjson rainbow "$rainbow" '{
        ok: true,
        theme: $theme,
        keyboard: $keyboard,
        matches: $matches,
        exact: ($source == "override-exact"),
        pinned: ($pinned != ""),
        pin: $pinned,
        brightness: $brightness,
        transport: $transport,
        effect: $effect,
        speed: $speed,
        transition: $transition,
        rainbow: $rainbow,
        devices: $devices,
        music: $music,
        musicBackground: $music_bg,
        musicBars: $music_bars
    }'
    ;;

preview)
    valid_hex "${1:-}" || fail "invalid colour"
    target=$(dry_target "$1")
    [ -n "$target" ] || fail "could not preview $1"
    jq -nc --arg keyboard "$target" '{ok: true, keyboard: $keyboard}'
    ;;

apply)
    valid_hex "${1:-}" || fail "invalid colour"
    # without --pin, --unpin clears an earlier pin only after the apply succeeded
    pin_args=(--unpin)
    if $pin; then pin_args=(--pin); fi
    run_strict "keyboard apply failed" apply ${exact[@]+"${exact[@]}"} "${pin_args[@]}" --color "$1"
    jq -nc '{ok: true}'
    ;;

reset)
    # clears the pin, the rainbow (the effect stays) and a picked colour, then applies the theme
    run_strict "keyboard apply failed" reset
    jq -nc '{ok: true}'
    ;;

choices)
    load_choices
    jq -c '{ok: true} + .' <<<"$CHOICES"
    ;;

palette)
    controller palette 2>/dev/null \
        | jq -R -nc '{ok: true, colors: [inputs | split(" ") | {source: .[0], target: .[1]}]}' \
        || fail "could not read the theme colours"
    ;;

rainbow)
    state=on
    case "${1:-}" in on|off) state=$1; shift ;; esac    # no argument means on
    speed_args=()
    [ -n "${1:-}" ] && speed_args=(--speed "$1")
    run_strict "could not set the rainbow" set-rainbow "$state" ${speed_args[@]+"${speed_args[@]}"}
    jq -nc '{ok: true}'
    ;;

effect)
    [ -n "${1:-}" ] || fail "no effect given"
    speed_args=()
    [ -n "${2:-}" ] && speed_args=(--speed "$2")
    run_strict "could not set effect $1" set-effect "$1" ${speed_args[@]+"${speed_args[@]}"}
    jq -nc '{ok: true}'
    ;;

transition)
    [[ ${1:-} =~ ^(none|fade|wave|explode)$ ]] || fail "transition must be none, fade, wave or explode"
    controller set-transition "$1" >/dev/null 2>&1 || fail "could not set the transition"
    jq -nc '{ok: true}'
    ;;

brightness)
    [[ ${1:-} =~ ^[1-5]$ ]] || fail "brightness must be 1-5"
    run_strict "could not set brightness" set-brightness "$1"
    jq -nc '{ok: true}'
    ;;

battery)
    devices=$(controller status --json 2>/dev/null | jq -r '.devices | join(",")' 2>/dev/null)
    [ "$devices" = "wireless" ] || fail "battery is only reported over the 2.4 GHz dongle"
    percent=$("$F75CTL" battery 2>/dev/null | grep -oE '[0-9]+') || fail "no battery reading"
    jq -nc --argjson percent "$percent" '{ok: true, percent: $percent}'
    ;;

music)
    case "${1:-}" in
    start)
        shift
        bars=$(cat "$MUSIC_BARS" 2>/dev/null); bars=${bars:-rainbow}
        bg=$(cat "$MUSIC_BG" 2>/dev/null); bg=${bg:-off}
        while [ $# -gt 0 ]; do
            case "$1" in
            --bars) [ $# -ge 2 ] || fail "--bars needs a name"; bars=$2; shift 2 ;;
            --background) [ $# -ge 2 ] || fail "--background needs a name"; bg=$2; shift 2 ;;
            off | theme) bg=$1; shift ;;      # the old form: music start off|theme
            *) fail "unknown argument $1" ;;
            esac
        done
        load_choices
        in_choices bars "$bars" || fail "unknown bar colour $bars"
        in_choices backgrounds "$bg" || fail "unknown background $bg"
        # theme: f75ctl reads the colour itself and again on SIGHUP, which the controller
        # sends on a theme change, so the background follows the theme
        if pid=$(music_pid) && { [ "$(cat "$MUSIC_BG" 2>/dev/null)" != "$bg" ] ||
                                 [ "$(cat "$MUSIC_BARS" 2>/dev/null)" != "$bars" ]; }; then
            # other colours: stop without handing back to the theme, then start again
            kill -USR1 "$pid"
            for _ in $(seq 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        fi
        if ! music_pid >/dev/null; then
            mkdir -p "$STATE_DIR"
            # setsid detaches it from the widget; it runs until `music stop`. Unbuffered,
            # so the start line reaches the log at once.
            PYTHONUNBUFFERED=1 nohup setsid "$F75CTL" music --color "$bars" --background "$bg" >"$MUSIC_LOG" 2>&1 </dev/null &
            started=$!
            printf '%s %s\n' "$started" "$(proc_start "$started")" >"$MUSIC_PID"
            # up to ~4 s for the visualiser's start line, or for it to exit
            confirmed=false
            for _ in $(seq 20); do
                if grep -q '^music: .*Ctrl+C to stop' "$MUSIC_LOG" 2>/dev/null; then confirmed=true; break; fi
                kill -0 "$started" 2>/dev/null || break
                sleep 0.2
            done
            if ! $confirmed || ! music_pid >/dev/null; then
                kill -TERM "$started" 2>/dev/null
                rm -f "$MUSIC_PID"
                error=$(grep -m1 -i 'f75ctl:\|error' "$MUSIC_LOG" | sed 's/^f75ctl: //')
                fail "${error:-music did not start}"
            fi
            printf '%s\n' "$bg" >"$MUSIC_BG"
            printf '%s\n' "$bars" >"$MUSIC_BARS"
        fi
        jq -nc '{ok: true, music: true}'
        ;;
    stop)
        if pid=$(music_pid); then
            kill -TERM "$pid"          # f75ctl then hands the keyboard back to the theme
            for _ in $(seq 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        fi
        rm -f "$MUSIC_PID"
        jq -nc '{ok: true, music: false}'
        ;;
    *) fail "usage: music start [--bars NAME] [--background NAME] | music start off|theme | music stop" ;;
    esac
    ;;

*)
    echo "usage: aula-f75 status|palette|preview|apply|reset|rainbow|effect|transition|brightness|choices|battery|music" >&2
    exit 2
    ;;
esac

#!/bin/bash
# Helper for the Keyboard Accent bar widget. Wraps omarchy-keyboard-accent.
# Every command prints one line of JSON, so the widget needs no exit codes.
#
#   status                              theme, keyboard colour, match, pin
#   targets [--exact] #HEX...           colour the keys would show for each, no writes
#   preview [--exact] #HEX              same for a single colour
#   apply   [--exact] [--pin] #HEX      set the keyboard
#   reset                               clear any pin, return to the theme colour
#   effect  NAME|default                show the accent as this effect (default: config's)
#   music   start [off|ambilight]       start the music visualiser (USB cable only)
#   music   stop                        stop it; the keyboard returns to the theme colour
#
# --exact uses the colour as written. Without it the controller applies the
# theme's saturation and lightness limits, which tint neutrals such as white.
# --pin keeps the colour across theme changes and reconnects; without it the
# colour lasts until the next theme change and any earlier pin is cleared.

set -u

CONTROLLER="$HOME/.local/bin/omarchy-keyboard-accent"
F75CTL="$HOME/.local/bin/f75ctl"
STATE_DIR="$HOME/.local/state/omarchy/keyboard-accent"
STATE="$STATE_DIR/state.json"
PIN="$STATE_DIR/pin.json"
MUSIC_PID="$STATE_DIR/music.pid"
MUSIC_LOG="$STATE_DIR/music.log"

# The pid of the running visualiser, if any.
music_pid() {
    local pid
    pid=$(cat "$MUSIC_PID" 2>/dev/null) || return 1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && grep -q f75ctl "/proc/$pid/cmdline" 2>/dev/null \
        && echo "$pid"
}

fail() {
    jq -nc --arg error "$1" '{ok: false, error: $error}'
    exit 1
}

valid_hex() { [[ ${1:-} =~ ^#[0-9A-Fa-f]{6}$ ]]; }

# Sum of per-channel differences between two #RRGGBB colours.
hex_distance() {
    local a=${1#\#} b=${2#\#} total=0 i diff
    for i in 0 2 4; do
        diff=$((16#${a:i:2} - 16#${b:i:2}))
        total=$((total + (diff < 0 ? -diff : diff)))
    done
    echo "$total"
}

# What the keys would show for a colour, via the controller's dry run.
dry_target() {
    "$CONTROLLER" apply --dry-run ${exact[@]+"${exact[@]}"} --color "$1" 2>/dev/null \
        | grep -oE 'target=#[0-9A-Fa-f]{6}' | head -n 1 | cut -d= -f2
}

command=${1:-}
[ $# -gt 0 ] && shift

exact=()
pin=false
while [ $# -gt 0 ]; do
    case "$1" in
    --exact) exact=(--exact) ;;
    --pin) pin=true ;;
    *) break ;;
    esac
    shift
done

if [ ! -x "$CONTROLLER" ]; then
    fail "Controller missing: run install.sh (see README)"
fi

case "$command" in
status)
    status=$("$CONTROLLER" status 2>/dev/null)
    theme=$(awk '/^target:/ {print $2}' <<<"$status")
    effect=$(awk '/^effect:/ {print $2}' <<<"$status")
    music=false
    music_pid >/dev/null && music=true
    [ -n "$theme" ] || fail "could not read the theme colour"
    keyboard="" source="" brightness=0 transport=""
    IFS=$'\t' read -r keyboard source brightness transport < <(
        jq -r '[.target // "", .accent_source // "", (.brightness // 0), (.transport // "")] | @tsv' "$STATE" 2>/dev/null
    )
    # Rounding in the controller can leave a colour a step or two off, which
    # the eye cannot tell apart, so treat a small distance as a match.
    matches=false
    if valid_hex "$keyboard" && [ "$(hex_distance "$theme" "$keyboard")" -le 3 ]; then
        matches=true
    fi
    pinned=$(jq -r '.color // empty' "$PIN" 2>/dev/null)
    jq -nc --arg theme "$theme" --arg keyboard "$keyboard" --arg source "$source" --arg pinned "$pinned" \
        --argjson matches "$matches" --argjson brightness "${brightness:-0}" --arg transport "$transport" \
        --arg effect "${effect:-static}" --argjson music "$music" '{
        ok: true,
        theme: $theme,
        keyboard: $keyboard,
        matches: $matches,
        exact: ($source == "override-exact"),
        pinned: ($pinned != ""),
        pin: $pinned,
        brightness: $brightness,
        transport: $transport,
        effect: $effect,
        music: $music
    }'
    ;;

targets)
    for hex in "$@"; do
        valid_hex "$hex" || continue
        target=$(dry_target "$hex")
        [ -n "$target" ] && printf '%s %s\n' "$hex" "$target"
    done | jq -R -nc '{ok: true, map: ([inputs | split(" ") | {(.[0]): .[1]}] | add // {})}'
    ;;

preview)
    valid_hex "${1:-}" || fail "invalid colour"
    target=$(dry_target "$1")
    [ -n "$target" ] || fail "could not preview $1"
    jq -nc --arg keyboard "$target" '{ok: true, keyboard: $keyboard}'
    ;;

apply)
    valid_hex "${1:-}" || fail "invalid colour"
    pin_args=()
    if $pin; then pin_args=(--pin); else "$CONTROLLER" unpin 2>/dev/null; fi
    "$CONTROLLER" apply ${exact[@]+"${exact[@]}"} ${pin_args[@]+"${pin_args[@]}"} --color "$1" >/dev/null 2>&1 || fail "keyboard apply failed"
    jq -nc '{ok: true}'
    ;;

reset)
    "$CONTROLLER" unpin 2>/dev/null
    "$CONTROLLER" apply >/dev/null 2>&1 || fail "keyboard apply failed"
    jq -nc '{ok: true}'
    ;;

effect)
    [ -n "${1:-}" ] || fail "no effect given"
    "$CONTROLLER" set-effect "$1" >/dev/null 2>&1 || fail "could not set effect $1"
    jq -nc '{ok: true}'
    ;;

music)
    case "${1:-}" in
    start)
        background=${2:-off}
        [[ $background =~ ^(off|ambilight)$ ]] || fail "unknown background $background"
        if ! music_pid >/dev/null; then
            mkdir -p "$STATE_DIR"
            # setsid detaches it from the widget; it runs until `music stop`
            nohup setsid "$F75CTL" music --background "$background" >"$MUSIC_LOG" 2>&1 </dev/null &
            echo $! >"$MUSIC_PID"
            sleep 1.5
            if ! music_pid >/dev/null; then
                error=$(grep -m1 -i 'f75ctl:\|error' "$MUSIC_LOG" | sed 's/^f75ctl: //')
                fail "${error:-music did not start}"
            fi
        fi
        jq -nc '{ok: true, music: true}'
        ;;
    stop)
        if pid=$(music_pid); then
            kill -TERM "$pid"          # f75ctl then hands the keyboard back to the theme
            for _ in $(seq 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        fi
        rm -f "$MUSIC_PID"
        jq -nc '{ok: true, music: false}'
        ;;
    *) fail "usage: music start [off|ambilight] | music stop" ;;
    esac
    ;;

*)
    echo "usage: keyboard-accent status|targets|preview|apply|reset|effect|music" >&2
    exit 2
    ;;
esac
